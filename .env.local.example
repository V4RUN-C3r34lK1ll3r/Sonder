# Sanity Project Configuration
# Get these from https://sanity.io/manage after creating your project

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API Token (for server-side reads of draft content)
# Create at https://sanity.io/manage -> API -> Tokens -> Add API token
# Give it "Viewer" role for production, "Editor" for development
SANITY_API_READ_TOKEN=your_read_token_here

# Contact Form — Formspree
# Create a free form at https://formspree.io and paste your endpoint here
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here
